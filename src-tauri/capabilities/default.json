{

  "identifier": "default",
  "description": "Default permissions for Arivu-Lens application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/compi-backend",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/compi-backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
